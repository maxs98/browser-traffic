#!/usr/bin/env bash
# cnbrowse 启动脚本：自动找 node 并转发所有参数
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

NODE_BIN="${NODE:-}"
if [ -z "$NODE_BIN" ]; then
  for cand in node /opt/homebrew/bin/node /usr/local/bin/node; do
    if command -v "$cand" >/dev/null 2>&1; then NODE_BIN="$cand"; break; fi
  done
fi
if [ -z "$NODE_BIN" ]; then
  # nvm / fnm / volta 兜底
  for f in "$HOME"/.nvm/versions/node/*/bin/node "$HOME"/.volta/bin/node "$HOME"/.local/share/fnm/node-versions/*/installation/bin/node; do
    [ -x "$f" ] && NODE_BIN="$f" && break
  done
fi
if [ -z "$NODE_BIN" ]; then echo "找不到 node（需要 Node 18+，可用 NODE=/path/to/node 指定）" >&2; exit 2; fi
exec "$NODE_BIN" "$DIR/cnbrowse.mjs" "$@"
